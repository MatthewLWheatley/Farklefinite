      m_Calls: []
  m_text: "Scoring\n\nStraight 1-6 = 5000\nStraight 1-5 or 2-6 = 2500\nThree of a
    kind: 1s give 1000, \neverything else is pip \xD7 100 (so three 4s = 400)\nFour/five/six
    of a kind multiply by 2 for each extra die\nSingle 1s = 100 each\nSingle 5s =
    50 each"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aae084d0fe2b56a4c8247a442c1028a2, type: 2}
