  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Game can be broke down int n steps:\n\n1. Roll all remaing Dice\n2.
    Check for Scoring capabilites\n3. a. If no scoreing dice combinations are rolled.
    Lose a life and got back to 1\n3. b. if scoring dice combinations are rolled
    continue\n4. select any combination of dice by clicking on them that create a
    score. (Dice that do not add to score are removed)\n5. a. set aside dice adding
    to the set a side score then returning to step 1. \n5. b. bank dice keeping the
    score gained so far but also losing a life the returning to step 1.\n5. c. If
    all dice are set a side then you have it a hot dice and are able to return to
    step 1 with all you dice and don't lose a dice."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aae084d0fe2b56a4c8247a442c1028a2, type: 2}
  m_sharedMaterial: {fileID: 440472713845906204, guid: 4ce59925d350ff644bb1e514285eeda3, type: 2}
